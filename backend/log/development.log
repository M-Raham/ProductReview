  [1m[36mProduct Load (0.6ms)[0m  [1m[34mSELECT "products".* FROM "products" WHERE "products"."category" = $1 AND "products"."id" != $2 LIMIT $3[0m  [["category", "Sports"], ["id", 2], ["LIMIT", 3]]
